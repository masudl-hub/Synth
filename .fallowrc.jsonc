{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["index.tsx", "functions/api/theorem/[[path]].ts", "vite.config.ts"],
  "ignorePatterns": [".wrangler/**"],
  // Generated by `astryx theme use`; astryx doctor checks it matches the generator byte for byte.
  "ignoreExports": [{ "file": "astryx-themes.ts", "exports": ["ThemeSlug"] }],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "circular-dependency": "error",
    "unresolved-imports": "error",
    "private-type-leaks": "error",
    "boundary-violations": "error"
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 30,
    "maxUnitSize": 120,
    "coverage": "coverage/coverage-final.json"
  },
  "duplicates": {
    "mode": "strict",
    "minTokens": 40,
    "minLines": 5,
    "minOccurrences": 2,
    "ignoreImports": true,
    "threshold": 2,
    "skipLocal": true
  },
  "audit": {
    "gate": "all"
  }
}
