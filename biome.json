{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!.wrangler",
      "!coverage",
      "!package-lock.json",
      "!**/*.md",
      "!astryx-themes.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "qwik": "none",
      "solid": "none",
      "next": "none",
      "vue": "none",
      "svelte": "none",
      "project": "all"
    },
    "rules": {
      "preset": "all",
      "correctness": {
        "noReactNativeRawText": "off",
        "noUnresolvedImports": "off"
      },
      "style": {
        "noReactNativeLiteralColors": "off"
      },
      "suspicious": {
        "useBaseline": {
          "level": "warn",
          "options": {
            "allowSelectors": ["selection"]
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["vite.config.ts", "vitest.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          },
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    }
  ]
}
